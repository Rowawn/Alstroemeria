{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Alstroemeria",
  "version": "0.1.1",
  "identifier": "com.alstroemeria.app",
  "build": {
    "beforeDevCommand": "npm run dev -w ui",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build -w ui",
    "frontendDist": "../ui/build"
  },
  "app": {
    "windows": [
      {
        "title": "Alstroemeria",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval' alstext: http://alstext.localhost",
        "connect-src": "ipc: http://ipc.localhost alstext: http://alstext.localhost",
        "frame-src": "alstext: http://alstext.localhost",
        "img-src": "'self' data: alstext: http://alstext.localhost",
        "style-src": "'self' 'unsafe-inline'",
        "media-src": "alstmedia: http://alstmedia.localhost",
        "worker-src": "blob:"
      },
      "devCsp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval' alstext: http://alstext.localhost 'unsafe-inline'",
        "connect-src": "ipc: http://ipc.localhost alstext: http://alstext.localhost ws: http://localhost:1420 http://127.0.0.1:1420",
        "frame-src": "alstext: http://alstext.localhost",
        "img-src": "'self' data: alstext: http://alstext.localhost",
        "style-src": "'self' 'unsafe-inline'",
        "media-src": "alstmedia: http://alstmedia.localhost",
        "worker-src": "blob:"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis",
      "appimage",
      "deb"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "versionCode": 101
    },
    "category": "Education",
    "shortDescription": "Local-first language immersion reader",
    "longDescription": "Read, listen and learn languages from your own texts and media. Everything stays on your devices and syncs over your local network.",
    "copyright": "Alstroemeria contributors",
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDExQThEREQ1NTMyQjU1NDcKUldSSFZTdFQxZDJvRVZ0SElaNHlHWTMvQk9sR0xHcnBnMXR6M050Wm1mS2M2YktaZUdtdU1JenQK",
      "endpoints": [
        "https://github.com/Rowawn/Alstroemeria/releases/latest/download/latest.json"
      ]
    }
  }
}
